{
  // 默认沙箱：Qt 6 + CMake + C++17，构建与界面检查都在容器里跑，不污染宿主机。
  "name": "Infinite Tokens Sandbox (Qt 6)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "view"
  },
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",
  // QML 语法支持 + CMake 工具；容器里没有真实显示器，界面用 offscreen 平台渲染。
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cmake-tools", "theqtcompany.qt-qml"],
      "settings": {
        "cmake.configureOnOpen": false
      }
    }
  },
  "postCreateCommand": "bash scripts/build.sh test",
  "runArgs": ["--init"]
}
